# Copie para .env e preencha os valores

# PostgreSQL
DATABASE_URL=

# Chave secreta para geração de API Keys (gere com: openssl rand -hex 32)
SECRET_KEY=

# Chave master para acesso ao painel admin
ADMIN_KEY=

# Rate limit padrão por cliente (requisições por minuto)
RATE_LIMIT_DEFAULT=10

# Cache: tempo em segundos para reutilizar resultado de busca igual
CACHE_TTL_SECONDS=300
